# Copia este archivo como .env y completa los valores. El .env real NUNCA se sube a GitHub.

# Base de datos PostgreSQL
#  - Local:  postgresql://postgres:TU_CLAVE@localhost:5432/rivibe?schema=public
#  - Neon:   la "connection string" que da neon.tech (termina en ?sslmode=require)
DATABASE_URL="postgresql://postgres:TU_CLAVE@localhost:5432/rivibe?schema=public"
# Solo en Neon/Vercel: DATABASE_URL = conexión "pooled" y DIRECT_URL = conexión directa (para migraciones).
# DIRECT_URL=""

# Administrador del panel /admin (lo crea `npm run db:seed` o `npm run admin:create`)
ADMIN_EMAIL="admin@rivibe.pe"
ADMIN_PASSWORD="cambia-esta-clave"
ADMIN_NAME="Equipo RIVIBE"

# Cloudinary: subida de fotos desde el panel en el sitio publicado.
# Panel de Cloudinary → "API Environment variable". Sin esto, en local se guardan en public/uploads.
CLOUDINARY_URL="cloudinary://API_KEY:API_SECRET@CLOUD_NAME"
